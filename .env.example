# ========================================================
# Variables de Entorno - Salón de Belleza API
# ========================================================

# Base de Datos (PostgreSQL)
POSTGRES_DB=salon_de_belleza_db
POSTGRES_USER=salon_admin
POSTGRES_PASSWORD=salon_password
POSTGRES_PORT=5432
DB_USERNAME=salon_admin
DB_PASSWORD=salon_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/salon_de_belleza_db?createDatabaseIfNotExist=true

# Cache distribuido (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Seguridad de Acceso Inicial y JWT
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=admin
SECURITY_JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
SECURITY_JWT_EXPIRATION_TIME=3600000

# Cifrado en Base de Datos para Datos Sensibles PII (AES - Clave secreta de 32 bytes)
SECURITY_DB_ENCRYPTION_KEY=EstaEsUnaClaveSecretaDe32Bytes!!

# Integración SMS (Twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
